<Window x:Class="ScreenWisp.Windows.BrushPopup" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ScreenWisp.Localization"
 Title="{Binding [PopupTitle], Source={x:Static loc:Localizer.Current}}" Width="304" Height="240" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False" WindowStartupLocation="Manual" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="24"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
   <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="3" Background="#69E6D0" CornerRadius="1.5"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
   <Track.Thumb><Thumb Width="13" Height="13"><Thumb.Template><ControlTemplate><Ellipse Fill="#69E6D0" Stroke="#B3FFF0" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
   <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="3" Background="#435362" CornerRadius="1.5"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
  </Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
   <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#DCE5EF"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#2A3543"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Margin="7" Background="#19222D" BorderBrush="#394653" BorderThickness="1" CornerRadius="15" Padding="17,14">
  <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.28"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="55"/><RowDefinition Height="Auto"/><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="ScreenWisp" Foreground="#F0F5F9" FontSize="16" FontWeight="SemiBold"/>
   <Button Content="×" HorizontalAlignment="Right" Width="25" Height="24" Click="CloseClick" ToolTip="{Binding [Close], Source={x:Static loc:Localizer.Current}}" AutomationProperties.Name="{Binding [CloseBrush], Source={x:Static loc:Localizer.Current}}"/>
   <TextBlock Grid.Row="1" Text="{Binding [BrushSubtitle], Source={x:Static loc:Localizer.Current}}" Foreground="#99AABB" FontSize="11" Margin="0,4,0,0"/>
   <StackPanel Grid.Row="2" x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center"/>
   <TextBlock Grid.Row="3" Text="{Binding [Thickness], Source={x:Static loc:Localizer.Current}}" Foreground="#C9D4DF" FontSize="12"/>
   <TextBlock Grid.Row="3" x:Name="WidthLabel" HorizontalAlignment="Right" Foreground="#99AABB" FontSize="12"/>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
    <Slider x:Name="WidthSlider" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="WidthChanged" AutomationProperties.Name="{Binding [BrushThickness], Source={x:Static loc:Localizer.Current}}"/>
    <Border AutomationProperties.Name="{Binding [BrushPreview], Source={x:Static loc:Localizer.Current}}" Grid.Column="1" Background="#111923" BorderBrush="#354351" BorderThickness="1" CornerRadius="8" Width="34" Height="28"><Ellipse x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </Grid>
   <Border Grid.Row="5" BorderBrush="#34404D" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,5,0,0">
    <Grid><Button Content="{Binding [Settings], Source={x:Static loc:Localizer.Current}}" HorizontalAlignment="Left" Padding="6,3" Click="SettingsClick" AutomationProperties.Name="{Binding [SettingsAccessible], Source={x:Static loc:Localizer.Current}}"/><TextBlock Text="{Binding [HoldHint], Source={x:Static loc:Localizer.Current}}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#8193A5" FontSize="11"/></Grid>
   </Border>
  </Grid>
 </Border>
</Window>
